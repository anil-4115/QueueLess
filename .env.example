# QueueLess environment variables
# Copy this file to .env before running the project.
# Never commit your real credentials to Git.

# MongoDB connection string from MongoDB Atlas
# Replace username, password, cluster and database name.
# If your password contains special characters, URL-encode them.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/QueueLess?retryWrites=true&w=majority&appName=QueueLess

# Server port
PORT=5000

# Optional override: defaults to 8.8.8.8,8.8.4.4 for Atlas SRV lookups.
# Only needed if Node reports "querySrv ECONNREFUSED" while nslookup works.
# DNS_SERVERS=8.8.8.8,1.1.1.1
